{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ways",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true }
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 8
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "RunAgent", "class_name": "RunAgent" },
      { "name": "Sandbox", "class_name": "Sandbox" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RunAgent", "Sandbox"]
    }
  ]
}
